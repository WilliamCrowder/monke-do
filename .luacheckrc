std = "lua51"
max_line_length = 120
codes = true
exclude_files = {
    "addon/MonkeDo/Libs",
    "addon/MonkeDo/Data",   -- generated by pipeline/export.py
    ".release",
}

-- Globals the addon defines.
globals = {
    "MonkeDoDB",
    "MonkeDo_OnAddonCompartmentClick",
    "MonkeDo_Pick",                 -- called by the key binding in Bindings.xml
    "BINDING_NAME_MONKEDO_PICK",
    "SLASH_MONKEDO1",
    "SLASH_MONKEDO2",
    "SlashCmdList",
}

-- WoW globals the addon reads. luacheck fails the build on anything not listed here.
read_globals = {
    "MonkeDB", "MonkeDB_Meta",
    "C_AddOns", "C_QuestLog", "CreateFrame", "GameTooltip", "LibStub", "Settings",
    "hooksecurefunc",
    "GetQuestID", "GetSuggestedGroupSize", "IsQuestCompletable",
    "GetRewardXP", "GetRewardMoney", "GetNumQuestRewards", "GetNumQuestChoices", "GetQuestItemInfo",
    "GetQuestLogRewardXP", "GetQuestLogRewardMoney", "GetNumQuestLogRewards", "GetQuestLogRewardInfo",
    "GetNumQuestLogChoices", "GetQuestLogChoiceInfo",
    "QuestFrame", "QuestFrameProgressPanel", "QuestInfoFrame", "QuestInfo_Display",
    "QuestInfoDescriptionText", "QuestInfoObjectivesText", "QuestInfoRewardText", "QuestProgressText",
    "QuestMapFrame",
    -- the quest giver's description fade (read only: the addon never starts or stops it)
    "QuestFrameDetailPanel", "QUEST_DESCRIPTION_GRADIENT_LENGTH",
    -- quest log view
    "QuestInfoObjectivesFrame", "QuestInfoObjectivesHeader", "QuestInfoDescriptionHeader",
    "GetObjectiveText", "GetQuestLogQuestText", "GetNumQuestLeaderBoards", "GetQuestLogLeaderBoard",
    "WAYPOINT_OBJECTIVE_FORMAT_OPTIONAL",
    -- Now line and Monke pick
    "C_SuperTrack", "C_Timer", "GetTime", "InCombatLockdown", "UIParent",
    "PlaySound", "SOUNDKIT", "issecretvalue",
    -- the Now line's arrow: where the player is and faces, where the quest is
    "C_Map", "GetPlayerFacing", "GetQuestUiMapID", "CreateVector2D",
    -- Deliberately NOT here: QuestMapFrame_* and other Blizzard map/tracker functions. Calling them
    -- from addon code taints the map and tracker; luacheck flags any use as an undefined global.
}

-- The stubs and specs build a fake client out of globals on purpose.
files["tests/lua"] = {
    std = "+busted",
    global = false,
    self = false,            -- no-op stub methods keep the colon syntax of the real widgets
    max_line_length = false, -- expected strings read better on one line
}
